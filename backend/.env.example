# Copy to .env and fill in.

ENVIRONMENT=development

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key: server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed if your project still uses the legacy HS256 JWT secret.
# Leave blank to verify tokens against the project's JWKS endpoint (recommended).
SUPABASE_JWT_SECRET=

# Postgres connection string (Dashboard -> Connect). Not used yet.
DATABASE_URL=

# Email reminders (optional). Without a key, the reminder job does nothing.
# Sign up at resend.com and verify your sending domain.
RESEND_API_KEY=
REMINDER_FROM=FatBoysFantasy <noreply@fatboysfantasy.com>
SITE_URL=https://fatboysfantasy.com
